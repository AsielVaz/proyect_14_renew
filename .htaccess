Options -Indexes
DirectoryIndex index.php

<FilesMatch "^(\.env(?:\..*)?|composer\.(?:json|lock)|.*\.(?:md|sql|log|ini)|database\.php)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?:config|src|views|vendor|tests)(?:/|$) - [F,L,NC]
</IfModule>

# El único controlador público PHP es index.php. Las clases, vistas y
# configuración continúan disponibles para includes internos, no por HTTP.
<FilesMatch "^(?!index\.php$).*\.php$">
    Require all denied
</FilesMatch>
