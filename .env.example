APP_NAME="Sistema 14"
APP_ENV=development
APP_URL=https://dev1.sistema14.com
APP_DEBUG=false
APP_TIMEZONE=America/Mexico_City
APP_KEY=generate_a_random_64_character_hex_secret
SESSION_NAME=S14DEV1SESSION
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_PATH=/
SESSION_SECURE_COOKIE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
SESSION_LIFETIME=7200
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=28800
AUTH_MAX_ATTEMPTS=5
AUTH_LOCK_SECONDS=900
TOTP_WINDOW=3
TRUST_PROXY=false
DASHBOARD_CACHE_SECONDS=30

WEBAUTHN_ENABLED=true
WEBAUTHN_RP_ID=sistema14.com
WEBAUTHN_RP_NAME="Sistema 14"
WEBAUTHN_ORIGIN=https://dev1.sistema14.com
WEBAUTHN_HANDLE_SECRET=replace_with_the_existing_64_character_secret
WEBAUTHN_TIMEOUT=60000
WEBAUTHN_USER_VERIFICATION=required
WEBAUTHN_CHALLENGE_TTL=120
WEBAUTHN_ENROLLMENT_TTL=300
WEBAUTHN_MAX_CREDENTIALS=20
WEBAUTHN_RECENT_AUTH_SECONDS=600
WEBAUTHN_MAX_OPTIONS_PER_MINUTE=30

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=database_name
DB_USERNAME=database_user
DB_PASSWORD=database_password
DB_CHARSET=utf8mb4

# Correos manuales (opcional; requerido únicamente para generar o enviar)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
MANDRILL_API_KEY=
S14_IMAP_HOST={mail.example.com:993/imap/ssl}
S14_IMAP_PASSWORD=
S14_IMAP_SENT_FOLDER=Sent
S14_AUDIT_EMAIL=
